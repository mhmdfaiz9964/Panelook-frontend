# Disable directory browsing
Options -Indexes -MultiViews

# Set default directory index
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 1. Real existing files -> serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Real existing directories with index.html -> serve directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 3. Dynamic Product Detail Route Fallback:
  # When newly added products are visited at /product/<slug> or /product/<slug>/,
  # rewrite to /product/index.html so ProductDetailClient fetches live data via API!
  RewriteRule ^product/([^/]+)/?$ /product/index.html [L,QSA]

  # 4. Dynamic Customer Orders Fallback:
  RewriteRule ^account/orders/([^/]+)/?$ /account/orders/view/index.html [L,QSA]

  # 5. Clean URLs for static HTML pages (e.g. /shop -> /shop.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/?$ /$1.html [L]

  # 6. Global SPA fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]

  # Error Document
  ErrorDocument 404 /404.html
</IfModule>
